{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "es2017",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": false,
    "noImplicitAny": false,
    "strictBindCallApply": false,
    "forceConsistentCasingInFileNames": false,
    "noFallthroughCasesInSwitch": false,
    "types": ["node"],
    "paths": {
      "domain": ["./src/_shared/domain"],
      "domain/*": ["./src/_shared/domain/*"],
      "app": ["./src/_shared/app"],
      "app/*": ["./src/_shared/app/*"],
      "adapter": ["./src/_shared/adapter"],
      "adapter/*": ["./src/_shared/adapter/*"],
      "framework": ["./src/_shared/framework"],
      "framework/*": ["./src/_shared/framework/*"],
      "todo/*": ["./src/todo/*"],
      "project/*": ["./src/project/*"],
      "product/*": ["./src/product/*"],
      "user": ["./src/user"],
      "user/*": ["./src/user/*"],
      "admin": ["./src/admin"],
      "admin/*": ["./src/admin/*"],
      "arbitre": ["./src/arbitre"],
      "arbitre/*": ["./src/arbitre/*"],
      "bet": ["./src/bet"],
      "bet/*": ["./src/bet/*"],
      "coupon": ["./src/coupon"],
      "coupon/*": ["./src/coupon/*"],
      "couponBet": ["./src/couponBet"],
      "couponBet/*": ["./src/couponBet/*"],
      "tournoi": ["./src/tournoi"],
      "tournoi/*": ["./src/tournoi/*"],
      "tournoiCoupon": ["./src/tournoiCoupon"],
      "tournoiCoupon/*": ["./src/tournoiCoupon/*"],
      "tournoiCouponBet": ["./src/tournoiCouponBet"],
      "tournoiCouponBet/*": ["./src/tournoiCouponBet/*"],
      "forgotpass": ["./src/forgotpass"],
      "forgotpass/*": ["./src/forgotpass/*"],
      "match": ["./src/match"],
      "match/*": ["./src/match/*"],
      "infos": ["./src/infos"],
      "infos/*": ["./src/infos/*"],
      "matchEvents": ["./src/matchEvents"],
      "matchEvents/*": ["./src/matchEvents/*"],
      "otp": ["./src/otp"],
      "otp/*": ["./src/otp/*"],
      "paris": ["./src/paris"],
      "paris/*": ["./src/paris/*"],
      "password": ["./src/password"],
      "password/*": ["./src/password/*"],
      "player": ["./src/player"],
      "player/*": ["./src/player/*"],
      "poule": ["./src/poule"],
      "poule/*": ["./src/poule/*"],
      "prononstic": ["./src/prononstic"],
      "prononstic/*": ["./src/prononstic/*"],
      "team": ["./src/team"],
      "team/*": ["./src/team/*"],
      "ticket": ["./src/ticket"],
      "ticket/*": ["./src/ticket/*"],
      "transactions": ["./src/transactions"],
      "transactions/*": ["./src/transactions/*"],
      "twilio": ["./src/twilio"],
      "twilio/*": ["./src/twilio/*"],
      "config/*": ["src/_shared/config/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "**/*.spec.ts"]
}
