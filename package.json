{
  "name": "app_starter",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "TANGUY",
  "bin": "dist/main.js",
  "pkg": {
    "scripts": [
      "dist/**/*.js",
      "persist/*.json"
    ],
    "assets": [
      "node_modules/swagger-ui-dist/swagger-ui.*",
      "node_modules/webpack/**/*",
      "node_modules/axios/**/*"
    ],
    "targets": [
      "win",
      "linux"
    ],
    "outputPath": "build"
  },
  "scripts": {
    "compodoc": "npx @compodoc/compodoc -p tsconfig.json -s",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" ",
    "lint:fix": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "prettier-format": "prettier --config .prettierrc \"{src,apps,libs,test}/**/*.ts\" --write",
    "prettier-watch": "prettier onchange \"{src,test}/**/*.ts\" -- prettier --write {{changed}}",
    "pkg": "nest build && rm -rf build/ && pkg ."
  },
  "dependencies": {
    "@nestjs/axios": "^3.0.3",
    "@nestjs/common": "^9.0.0",
    "@nestjs/config": "^3.0.0",
    "@nestjs/core": "^10.4.1",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.1",
    "@nestjs/platform-socket.io": "^10.4.1",
    "@nestjs/schedule": "^4.1.1",
    "@nestjs/swagger": "^7.1.1",
    "@nestjs/typeorm": "^10.0.0",
    "@nestjs/websockets": "^10.4.1",
    "axios": "^1.4.0",
    "bcrypt": "^5.1.1",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "helmet": "^7.0.0",
    "nest-winston": "^1.9.3",
    "nestjs-command": "^3.1.4",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.15",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.11.1",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.2.0",
    "twilio": "^5.3.2",
    "typeorm": "^0.3.17",
    "winston": "^3.10.0"
  },
  "devDependencies": {
    "@compodoc/compodoc": "^1.1.21",
    "@faker-js/faker": "^8.0.2",
    "@nestjs/cli": "^10.4.5",
    "@nestjs/schematics": "^9.0.0",
    "@nestjs/testing": "^10.4.1",
    "@types/bcryptjs": "^2.4.2",
    "@types/express": "^4.17.13",
    "@types/jest": "29.2.4",
    "@types/multer": "^1.4.7",
    "@types/node": "18.11.18",
    "@types/supertest": "^2.0.11",
    "@typescript-eslint/eslint-plugin": "^5.0.0",
    "@typescript-eslint/parser": "^5.0.0",
    "eslint": "^8.0.1",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "29.3.1",
    "onchange": "^7.1.0",
    "prettier": "^3.0.0",
    "source-map-support": "^0.5.20",
    "supertest": "^6.1.3",
    "ts-jest": "29.0.3",
    "ts-loader": "^9.2.3",
    "ts-node": "^10.0.0",
    "tsconfig-paths": "4.1.1",
    "typescript": "^4.7.4"
  }
}
